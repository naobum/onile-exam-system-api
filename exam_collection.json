		{
			"name": "3. Student Actions",
			"item": [
				{
					"name": "Start Exam",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if(jsonData.attemptId) {",
									"    pm.globals.set(\"attempt_id\", jsonData.attemptId);",
									"    // Сохраняем ID первого вопроса для теста",
									"    if(jsonData.questions && jsonData.questions.length > 0) {",
									"        pm.globals.set(\"question_id\", jsonData.questions[0].id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{student_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/exam/start/{{template_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"exam",
								"start",
								"{{template_id}}"
							]
						}
					},
					"response": []
				},
